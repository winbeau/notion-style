{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "notion-style",
    "displayName": "Notion-Style Cross-Framework Design Paradigm",
    "version": "1.0.0",
    "description": "Single source of truth distilled from xju-feiyue, xju-OJ, auth-login, xju-feiyue-cs336, email-sift, and FastFinder/Panthera-WAM."
  },
  "themes": {
    "light": {
      "surface": {
        "bg": "#ffffff",
        "bgSubtle": "#f7f6f3",
        "bgHover": "#f1f1ef",
        "bgElevated": "#ffffff",
        "glowWarm": "rgba(217, 115, 13, 0.06)",
        "glowCool": "rgba(11, 110, 153, 0.05)",
        "gridLine": "rgba(55, 53, 47, 0.06)"
      },
      "text": {
        "primary": "#37352f",
        "muted": "#787774",
        "faint": "#9b9a97"
      },
      "border": {
        "subtle": "#edece9",
        "strong": "#dcdad4"
      },
      "brand": {
        "primary": "#37352f",
        "primaryHover": "#25231f",
        "primaryFg": "#ffffff",
        "link": "#2383e2",
        "focus": "#2383e2"
      },
      "code": {
        "inlineBg": "rgba(135, 131, 120, 0.15)",
        "inlineFg": "#eb5757"
      },
      "highlight": {
        "flashBg": "rgba(255, 213, 79, 0.45)"
      },
      "chart": {
        "primary": "#2383e2",
        "secondary": "#34a896",
        "grid": "#edece9"
      },
      "shadow": {
        "card": "0 1px 2px rgba(0, 0, 0, 0.04)",
        "panel": "0 8px 24px rgba(55, 53, 47, 0.06)",
        "dialog": "0 14px 40px rgba(55, 53, 47, 0.12)"
      }
    },
    "dark": {
      "surface": {
        "bg": "#0d1117",
        "bgSubtle": "#161b22",
        "bgHover": "#1c2128",
        "bgElevated": "#21262d",
        "glowWarm": "rgba(210, 153, 34, 0.08)",
        "glowCool": "rgba(56, 139, 253, 0.08)",
        "gridLine": "rgba(230, 237, 243, 0.05)"
      },
      "text": {
        "primary": "#e6edf3",
        "muted": "#8b949e",
        "faint": "#6e7681"
      },
      "border": {
        "subtle": "#30363d",
        "strong": "#444c56"
      },
      "brand": {
        "primary": "#388bfd",
        "primaryHover": "#58a6ff",
        "primaryFg": "#ffffff",
        "link": "#58a6ff",
        "focus": "#388bfd"
      },
      "code": {
        "inlineBg": "rgba(110, 118, 129, 0.22)",
        "inlineFg": "#ff7b72"
      },
      "highlight": {
        "flashBg": "rgba(210, 153, 34, 0.35)"
      },
      "chart": {
        "primary": "#58a6ff",
        "secondary": "#3fb950",
        "grid": "#30363d"
      },
      "shadow": {
        "card": "0 1px 3px rgba(0, 0, 0, 0.32), 0 0 0 1px rgba(255, 255, 255, 0.04)",
        "panel": "0 8px 24px rgba(0, 0, 0, 0.42)",
        "dialog": "0 16px 48px rgba(0, 0, 0, 0.56)"
      }
    }
  },
  "categories": {
    "research": {
      "label": "科研",
      "labelEn": "Research",
      "desc": "论文阅读 · Idea 探索 · 实验复现",
      "icon": "Microscope",
      "light": { "fg": "#e03e3e", "bg": "rgba(224, 62, 62, 0.12)" },
      "dark": { "fg": "#f85149", "bg": "rgba(248, 81, 73, 0.16)" }
    },
    "course": {
      "label": "课程",
      "labelEn": "Course",
      "desc": "选课指南 · 课堂笔记 · 考核要点",
      "icon": "BookOpen",
      "light": { "fg": "#d9730d", "bg": "rgba(217, 115, 13, 0.12)" },
      "dark": { "fg": "#d29922", "bg": "rgba(210, 153, 34, 0.16)" }
    },
    "recommend": {
      "label": "推免",
      "labelEn": "Admission",
      "desc": "夏令营 · 预推免 · 导师沟通",
      "icon": "GraduationCap",
      "light": { "fg": "#9065b0", "bg": "rgba(144, 101, 176, 0.12)" },
      "dark": { "fg": "#bc8cff", "bg": "rgba(188, 140, 255, 0.16)" }
    },
    "competition": {
      "label": "竞赛",
      "labelEn": "Contest",
      "desc": "ACM · 数学建模 · 机器人赛",
      "icon": "Trophy",
      "light": { "fg": "#b8405e", "bg": "rgba(184, 64, 94, 0.12)" },
      "dark": { "fg": "#f778ba", "bg": "rgba(247, 120, 186, 0.16)" }
    },
    "kaggle": {
      "label": "数据",
      "labelEn": "Data & AI",
      "desc": "特征工程 · 评测榜单 · 训练流水线",
      "icon": "BarChart3",
      "light": { "fg": "#0b6e99", "bg": "rgba(11, 110, 153, 0.12)" },
      "dark": { "fg": "#58a6ff", "bg": "rgba(88, 166, 255, 0.16)" }
    },
    "tools": {
      "label": "工具",
      "labelEn": "Tooling",
      "desc": "Linux · Git · CLI · 自动化工作流",
      "icon": "Wrench",
      "light": { "fg": "#0f7b6c", "bg": "rgba(15, 123, 108, 0.12)" },
      "dark": { "fg": "#3fb950", "bg": "rgba(63, 185, 80, 0.16)" }
    },
    "life": {
      "label": "日常",
      "labelEn": "Notes",
      "desc": "团队周记 · 经验沉淀 · 随笔记录",
      "icon": "Coffee",
      "light": { "fg": "#b5926a", "bg": "rgba(181, 146, 106, 0.12)" },
      "dark": { "fg": "#d4a76a", "bg": "rgba(212, 167, 106, 0.16)" }
    }
  },
  "statuses": {
    "success": {
      "label": "通过 / 正常",
      "light": {
        "fg": "#0f5e54",
        "bg": "rgba(15, 123, 108, 0.12)",
        "border": "rgba(15, 123, 108, 0.32)"
      },
      "dark": {
        "fg": "#3fb950",
        "bg": "rgba(63, 185, 80, 0.15)",
        "border": "rgba(63, 185, 80, 0.35)"
      }
    },
    "warning": {
      "label": "提示 / 待处理",
      "light": {
        "fg": "#d9730d",
        "bg": "rgba(217, 115, 13, 0.12)",
        "border": "rgba(217, 115, 13, 0.32)"
      },
      "dark": {
        "fg": "#d29922",
        "bg": "rgba(210, 153, 34, 0.15)",
        "border": "rgba(210, 153, 34, 0.35)"
      }
    },
    "danger": {
      "label": "异常 / 拒绝",
      "light": {
        "fg": "#b91c1c",
        "bg": "rgba(224, 62, 62, 0.12)",
        "border": "rgba(224, 62, 62, 0.32)"
      },
      "dark": {
        "fg": "#f85149",
        "bg": "rgba(248, 81, 73, 0.15)",
        "border": "rgba(248, 81, 73, 0.35)"
      }
    },
    "neutral": {
      "label": "归档 / 锁定",
      "light": {
        "fg": "#787774",
        "bg": "rgba(155, 154, 151, 0.10)",
        "border": "rgba(155, 154, 151, 0.28)"
      },
      "dark": {
        "fg": "#8b949e",
        "bg": "rgba(110, 118, 129, 0.12)",
        "border": "rgba(110, 118, 129, 0.30)"
      }
    }
  },
  "typography": {
    "sans": "'Inter Tight', 'Geist', 'PingFang SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "serif": "'Source Serif 4', 'Noto Serif SC', Georgia, 'Songti SC', serif",
    "mono": "'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace",
    "uiFontSize": "15px",
    "proseFontSize": "16px",
    "lineHeightUi": "1.5",
    "lineHeightProse": "1.75"
  },
  "radii": {
    "xs": 4,
    "sm": 6,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "pill": 9999,
    "presets": {
      "compact": { "sm": 4, "md": 6, "lg": 8, "desc": "高密度开发工具 / OJ 判题台 (xju-OJ, cs336)" },
      "editorial": { "sm": 6, "md": 8, "lg": 12, "desc": "知识库与通用 SaaS 默认档 (xju-feiyue, auth-login)" },
      "native": { "sm": 8, "md": 12, "lg": 16, "desc": "macOS / 桌面卡片舒展档 (email-sift)" }
    }
  },
  "motion": {
    "fast": "150ms ease",
    "spring": "220ms cubic-bezier(0.2, 0.8, 0.2, 1)",
    "durationMs": 150
  },
  "layout": {
    "readingWidth": 720,
    "contentWidth": 1120,
    "wideWidth": 1400,
    "headerHeight": 56,
    "controlHeightSm": 32,
    "controlHeightMd": 36,
    "touchTarget": 44
  }
}
